rules_version = '2';

// Watch The Hutch. Deploy with `firebase deploy --only firestore:rules`, or paste into
// Firebase console > Firestore > Rules.
//
// The edge device writes with a service account (Admin credentials), which bypasses these
// rules. Browsers can read what the public page needs; only signed-in admins write.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The live state: everyone reads, admins override it or hand it back to the device.
    match /bridgeState/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // History of state changes: written by the admin form and the device, never edited.
    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Device-only data: phase changes, boat crossings, telemetry.
    match /deviceEvents/{eventId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /devices/{deviceId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Simulations are admin-only. The app lists them all and filters by owner in the
    // browser, so reads can't be limited to the owner here without changing that query.
    match /simulations/{simulationId} {
      allow read, update, delete: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
